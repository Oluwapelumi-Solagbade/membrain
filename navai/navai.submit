# condor_submit navai/navai.submit   (run from ~/membrain)
# Only x86_64 GPU nodes can run our venv (torch cu130); the gpuNN nodes are ppc64le (IBM POWER).
# Keep the request small: x86 GPU slots are scarce, and the model cache lives in $HOME (no local disk needed).
universe       = vanilla
executable     = navai/run_navai.sh
getenv         = True
request_gpus   = 1
request_cpus   = 1
request_memory = 12G
requirements   = (Arch == "X86_64")
output         = logs/navai.out
error          = logs/navai.err
log            = logs/navai.log
queue
