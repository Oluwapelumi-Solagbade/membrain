# Microsoft Azure Speech Service (UAE North - Dubai)
# Copy to .env (git-ignored) for local runs. On Azure App Service set these as Application settings instead.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=uaenorth
ALLOWED_ORIGINS=https://teamcerebrospark.github.io,https://oluwapelumi-solagbade.github.io,http://localhost:8000
SPEECH_TOKENS_PER_MINUTE=20

# Telegram bot (docs/TELEGRAM_BOT.md). Token from @BotFather; never commit it.
# With only the token set, the API polls Telegram (local dev). On Azure also set TELEGRAM_WEBHOOK_URL.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_URL=

# Sign-in (api/auth.py). The synthetic demo accounts are on by default; set DEMO_ACCOUNTS=0 for anything real.
# The demo clinicians' password defaults to the value in api/auth.py; set your own here.
DEMO_ACCOUNTS=1
CLINICIAN_DEMO_PASSWORD=
# No SMS gateway in the prototype, so the patient's one-time code is shown on screen. Set 0 once SMS is wired up.
DEMO_OTP=1
# Only for the old prototype and tests: trust an X-Role header instead of a signed-in session. Never in production.
ALLOW_ROLE_HEADER=0
