# condor_submit asr/export.submit   (run from ~/membrain; no GPU needed)
universe       = vanilla
executable     = asr/run_export.sh
getenv         = True
request_cpus   = 4
request_memory = 12G
request_disk   = 10G
output         = logs/export.out
error          = logs/export.err
log            = logs/export.log
queue
